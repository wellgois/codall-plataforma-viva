// ============================================================
// medidas.dax — Dashboard JogandoLógica
// Colar no Power BI Desktop -> Nova medida (uma por linha).
// ============================================================

Total Pontos = SUM ( bi_fato_atividade[pontos] )
Total Atividades = COUNTROWS ( bi_fato_atividade )
Alunos Distintos = DISTINCTCOUNT ( bi_fato_atividade[aluno_sk] )
Jogos Distintos = DISTINCTCOUNT ( bi_fato_atividade[jogo_sk] )
Acertos = SUM ( bi_fato_atividade[acertos] )
Erros = SUM ( bi_fato_atividade[erros] )
Tentativas = SUM ( bi_fato_atividade[tentativas] )
Taxa de Acerto % = DIVIDE ( [Acertos], [Tentativas] )
Media Pontos por Aluno = DIVIDE ( [Total Pontos], [Alunos Distintos] )
Media Pontos por Atividade = DIVIDE ( [Total Pontos], [Total Atividades] )
Minutos Totais = DIVIDE ( SUM ( bi_fato_atividade[segundos] ), 60 )
Media Minutos/Atividade = DIVIDE ( SUM ( bi_fato_atividade[segundos] ), [Total Atividades] ) / 60
Pontos YTD = TOTALYTD ( [Total Pontos], bi_dim_data[data] )
Pontos MoM % =
    VAR atual = [Total Pontos]
    VAR anterior = CALCULATE ( [Total Pontos], DATEADD ( bi_dim_data[data], -1, MONTH ) )
    RETURN DIVIDE ( atual - anterior, anterior )
Pontos WoW % =
    VAR atual = [Total Pontos]
    VAR anterior = CALCULATE ( [Total Pontos], DATEADD ( bi_dim_data[data], -7, DAY ) )
    RETURN DIVIDE ( atual - anterior, anterior )
Pontos Ultimos 7 Dias =
    CALCULATE ( [Total Pontos], DATESINPERIOD ( bi_dim_data[data], MAX ( bi_dim_data[data] ), -7, DAY ) )
Pontos Ultimos 30 Dias =
    CALCULATE ( [Total Pontos], DATESINPERIOD ( bi_dim_data[data], MAX ( bi_dim_data[data] ), -30, DAY ) )
Ranking Aluno =
    RANKX ( ALLSELECTED ( bi_fato_atividade[aluno_sk] ), [Total Pontos], , DESC, Dense )
Ranking Jogo =
    RANKX ( ALLSELECTED ( bi_fato_atividade[jogo_sk] ), [Total Pontos], , DESC, Dense )
Faixa Engajamento =
    VAR p = [Total Pontos]
    RETURN SWITCH ( TRUE(), p >= 1000, "Alto", p >= 300, "Medio", p > 0, "Baixo", "Sem atividade" )
% Ativos / Total =
    VAR ativos = CALCULATE ( DISTINCTCOUNT ( bi_fato_atividade[aluno_sk] ), bi_fato_atividade[pontos] > 0 )
    VAR total  = DISTINCTCOUNT ( bi_fato_atividade[aluno_sk] )
    RETURN DIVIDE ( ativos, total )
Alunos Ativos no Mes =
    CALCULATE (
        DISTINCTCOUNT ( bi_fato_atividade[aluno_sk] ),
        DATESINPERIOD ( bi_dim_data[data], MAX ( bi_dim_data[data] ), -1, MONTH )
    )
Media Tentativas/Aluno = DIVIDE ( [Tentativas], [Alunos Distintos] )
%Sessoes Finalizadas =
    DIVIDE (
        CALCULATE ( COUNTROWS ( bi_fato_atividade ), bi_fato_atividade[status] = "finalizado" ),
        [Total Atividades]
    )
EOF
