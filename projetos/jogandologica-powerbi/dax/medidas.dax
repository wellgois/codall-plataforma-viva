Total Pontos = SUM ( bi_fato_atividade[pontos] )
Total Atividades = COUNTROWS ( bi_fato_atividade )
Alunos Distintos = DISTINCTCOUNT ( bi_fato_atividade[aluno_sk] )
Jogos Distintos = DISTINCTCOUNT ( bi_fato_atividade[jogo_sk] )
Media Pontos por Aluno = DIVIDE ( [Total Pontos], [Alunos Distintos] )
Media Pontos por Atividade = DIVIDE ( [Total Pontos], [Total Atividades] )
Acertos = SUM ( bi_fato_atividade[acertos] )
Tentativas = SUM ( bi_fato_atividade[tentativas] )
Taxa de Acerto % = DIVIDE ( [Acertos], [Tentativas] )
Tempo Total (h) = DIVIDE ( SUM ( bi_fato_atividade[segundos] ), 3600 )
Tempo Medio/Atividade (min) = DIVIDE ( SUM ( bi_fato_atividade[segundos] ), [Total Atividades] ) / 60
Pontos YTD = TOTALYTD ( [Total Pontos], bi_dim_data[data] )
Pontos MoM % = VAR atual=[Total Pontos] VAR anterior=CALCULATE([Total Pontos],DATEADD(bi_dim_data[data],-1,MONTH)) RETURN DIVIDE(atual-anterior,anterior)
Pontos WoW % = VAR atual=[Total Pontos] VAR anterior=CALCULATE([Total Pontos],DATEADD(bi_dim_data[data],-7,DAY)) RETURN DIVIDE(atual-anterior,anterior)
Ranking Aluno = RANKX ( ALLSELECTED(bi_dim_aluno[aluno_nome]), [Total Pontos], , DESC, Dense )
Faixa Engajamento = VAR p=[Total Pontos] RETURN SWITCH(TRUE(), p>=1000,"Alto", p>=300,"Medio", p>0,"Baixo","Sem atividade")
% Sessoes com aluno identificado = VAR b=CALCULATE([Total Atividades],bi_fato_atividade[tipo_atividade]="sessao") VAR o=CALCULATE([Total Atividades],bi_fato_atividade[tipo_atividade]="sessao",NOT ISBLANK(bi_fato_atividade[aluno_sk])) RETURN DIVIDE(o,b)
% Sessoes com jogo identificado = VAR b=CALCULATE([Total Atividades],bi_fato_atividade[tipo_atividade]="sessao") VAR o=CALCULATE([Total Atividades],bi_fato_atividade[tipo_atividade]="sessao",NOT ISBLANK(bi_fato_atividade[jogo_sk])) RETURN DIVIDE(o,b)
Pontos Ultimos 7 Dias = CALCULATE ( [Total Pontos], DATESINPERIOD(bi_dim_data[data], MAX(bi_dim_data[data]), -7, DAY) )
Pontos Ultimos 30 Dias = CALCULATE ( [Total Pontos], DATESINPERIOD(bi_dim_data[data], MAX(bi_dim_data[data]), -30, DAY) )
