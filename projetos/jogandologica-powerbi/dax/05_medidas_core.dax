// =====================================================================
// Medidas DAX do Projeto da Semana — Jogando Lógica (Power BI)
// Modelo: estrela bi_fato_atividade + bi_dim_data / aluno / jogo /
//         escola / disciplina
// Data de referência observada no fato: 2026-04-27..2026-11-16
// 5 medidas obrigatórias (as demais são suporte):
//   1) Pontos YTD
//   2) Pontos MoM %
//   3) Ranking Aluno
//   4) Pontos MM3M   (média móvel de 3 meses)
//   5) Participação % (share do aluno no total do contexto)
// =====================================================================

// ---------- Base ----------
Total Pontos = SUM ( bi_fato_atividade[pontos] )
Total Atividades = COUNTROWS ( bi_fato_atividade )
Alunos Distintos = DISTINCTCOUNT ( bi_fato_atividade[aluno_sk] )

// ---------- 1) YTD ----------
// YTD acumulado de pontos no ano do contexto.
// TOTALYTD respeita o filtro de data corrente e reinicia em 1º/jan.
// Bi_dim_data precisa estar marcada como tabela de datas.
Pontos YTD =
TOTALYTD ( [Total Pontos], bi_dim_data[data] )

// ---------- 2) Variação mês a mês ----------
// % vs mesmo período do mês anterior, no mesmo ano.
// DATEADD -1 MONTH exige contexto de mês completo — em visuais
// mensais funciona; em tabela diária troque por PREVIOUSMONTH.
Pontos MoM % =
VAR atual    = [Total Pontos]
VAR anterior = CALCULATE ( [Total Pontos], DATEADD ( bi_dim_data[data], -1, MONTH ) )
RETURN
    DIVIDE ( atual - anterior, anterior )

// ---------- 3) Ranking ----------
// Ranking denso do aluno por pontos, respeitando filtros externos
// (ALLSELECTED para ranking "visível ao usuário", não absoluto).
// Empate: RANKX denso devolve o mesmo número (1,1,2,...).
Ranking Aluno =
RANKX (
    ALLSELECTED ( bi_dim_aluno[aluno_id] ),
    [Total Pontos],
    ,
    DESC,
    Dense
)

// ---------- 4) Média móvel de 3 meses ----------
// Média aritmética de [Total Pontos] em três meses consecutivos,
// terminando no mês da linha de contexto.
// AVERAGEX sobre DATESINPERIOD divide pela contagem real de meses.
Pontos MM3M =
VAR fim = MAX ( bi_dim_data[data] )
VAR janela =
    DATESINPERIOD ( bi_dim_data[data], fim, -3, MONTH )
RETURN
    DIVIDE (
        CALCULATE ( [Total Pontos], janela ),
        CALCULATE ( DISTINCTCOUNT ( bi_dim_data[ano_mes] ), janela )
    )

// ---------- 5) Participação percentual ----------
// Share do aluno (ou da linha de contexto) no total do mês,
// desconsiderando o filtro do próprio aluno.
Participação % =
VAR linha = [Total Pontos]
VAR totalMes =
    CALCULATE (
        [Total Pontos],
        ALLSELECTED ( bi_dim_aluno),
        VALUES ( bi_dim_data[ano_mes] )
    )
RETURN
    DIVIDE ( linha, totalMes )

// ---------- Suporte / diagnóstico ----------
Acertos = SUM ( bi_fato_atividade[acertos] )
Tentativas = SUM ( bi_fato_atividade[tentativas] )
Taxa de Acerto % = DIVIDE ( [Acertos], [Tentativas] )
Tempo Total (h) = DIVIDE ( SUM ( bi_fato_atividade[segundos] ), 3600 )
Pontos Últimos 7 Dias =
CALCULATE ( [Total Pontos], DATESINPERIOD ( bi_dim_data[data], MAX ( bi_dim_data[data] ), -7, DAY ) )
Pontos Últimos 30 Dias =
CALCULATE ( [Total Pontos], DATESINPERIOD ( bi_dim_data[data], MAX ( bi_dim_data[data] ), -30, DAY ) )
